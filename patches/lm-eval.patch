+
+class BudgetTokenizer:
+    """Reserve 256 tokens for chat wrapping and answer prefix during sizing only."""
+    def __init__(self, tokenizer):
+        self.tokenizer = tokenizer
+
+    def __getattr__(self, name):
+        return getattr(self.tokenizer, name)
+
+    def __call__(self, *args, **kwargs):
+        encoded = self.tokenizer(*args, **kwargs)
+        if not isinstance(encoded.input_ids, list) or (encoded.input_ids and isinstance(encoded.input_ids[0], list)):
+            raise ValueError('RULER budget tokenizer expects one text string')
+        encoded['input_ids'] = encoded.input_ids + [0] * 256
+        return encoded
+
 # The keys a model name can arrive under. RULER tasks are handed the parsed
 # `--model_args`, and each backend names the model differently: `pretrained`
 # for local HuggingFace models, `model` for the API backends.
